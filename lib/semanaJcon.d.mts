import type { GrupoJcon } from "./vivoJcon.d.mts";
export type CodigoDiaJcon = "V" | "A" | "N" | "R" | "R?" | "P" | "-";
export type CodigoSemanaJcon = "SI" | "NO" | "NO?" | "P";
export type EstudianteSemanaJcon = { id: number; cohorte_jcon?: string | null; cedula: string | number | null; nombres?: string | null; apellidos?: string | null;
  horario: string | null; estado: string | null; grupo_ciudad?: string | null };
export type ClaseJcon = { id: number; cohorte_jcon?: string | null; fecha: string; horario: string | null; tema: string | null; tipo: string | null;
  numero_semana?: number | null; duracion_min?: number | null };
export type AsistenciaJcon = { clase_id: number; estudiante_id: number; asistio?: boolean | null; fuente?: string | null; minutos?: number | null };
export type DatosJcon = { estudiantes: EstudianteSemanaJcon[]; clases: ClaseJcon[]; asistencia: AsistenciaJcon[] };
export type OpcionSemanaJcon = { semana: string; clave: string; etiqueta: string; bienvenida: boolean };
export type FiltroJcon = { ciudad?: string; grupo?: GrupoJcon };
export type IngresoJcon = { poblacion: number; asistieron: number; nunca: number; pendientes: number; horario: number; colados: number; ambos: number;
  porcentaje_retencion: number | null; porcentaje_nunca: number | null; porcentaje_horario: number | null; porcentaje_colados: number | null;
  porcentaje_ambos: number | null };
export type ColumnaJcon = IngresoJcon & { id: string; fecha: string; tema: string; tipo: string | null; grupo: GrupoJcon; etiqueta_grupo: string;
  ocurrio: boolean; inscritas: number; codigos: Record<CodigoDiaJcon, number>; en_curso: boolean };
export type SemanaJconResponse = {
  programa: "jcon"; semana: string; terminada: boolean; hoy: string; filtro: FiltroJcon; ciudades: string[];
  roster: number; retirados_excluidos: number; sin_grupo: number;
  columnas: ColumnaJcon[]; semanal: Record<CodigoSemanaJcon, number>;
  porGrupo: (IngresoJcon & { grupo: GrupoJcon; etiqueta: string; roster: number; semanal: Record<CodigoSemanaJcon, number> })[];
  resumen: IngresoJcon & { en_curso: boolean };
  inconsistencias: { fuente: number; horario: number }; sesiones_sin_grupo: number;
  actualizado_en?: string; aviso?: string | null;
};
export type BaseJcon = { semana: string; hoy: string; terminada: boolean;
  columnas: { id: string; fecha: string; tema: string; tipo: string | null; grupo: GrupoJcon; ocurrio: boolean }[];
  roster: { filas: { id: number; grupo: GrupoJcon; ciudad: string | null; nombre: string; cedula: string }[]; retirados: number; sinGrupo: number };
  entro: Map<number, Set<string>>; inconsistencias: { fuente: number; horario: number }; sinDueno: number };
export const CODIGOS_DIA_JCON: readonly { codigo: CodigoDiaJcon; texto: string }[];
export const CODIGOS_SEMANA_JCON: readonly { codigo: CodigoSemanaJcon; texto: string }[];
export const CLAVE_JCON: string;
export const CIUDADES_JCON: Record<string, string>;
export const LEYENDA_CSV_JCON: string;
export function esClaveJcon(clave: unknown): boolean;
export function semanaDeClave(clave: unknown): string | null;
export function nombreCiudadJcon(c: unknown): string | null;
export function mismaCiudadJcon(ciudadJcon: unknown, ciudad: unknown): boolean;
export function grupoDeSesion(c: { tipo?: unknown; tema?: unknown; fecha?: string | null }): GrupoJcon | null;
export function hoyCOT(ms?: number): string;
export function semanaTerminada(lunes: string, hoy: string): boolean;
export function sesionesPorSemana(clases: ClaseJcon[], asistencia?: AsistenciaJcon[]): Map<string, unknown[]>;
export function listarSemanasJcon(clases: ClaseJcon[]): OpcionSemanaJcon[];
export function rosterSemanaJcon(estudiantes: EstudianteSemanaJcon[]): BaseJcon["roster"];
export function construirBaseJcon(lunes: string, datos: DatosJcon, hoy: string): BaseJcon;
export function codigosPersona(base: BaseJcon, persona: { id: number; grupo: GrupoJcon }): { porColumna: Record<string, CodigoDiaJcon>; semana: CodigoSemanaJcon;
  tipo: "horario" | "colados" | null };
export function calcularSemanaJcon(base: BaseJcon, filtro?: FiltroJcon): SemanaJconResponse;
export function filasNominalJcon(base: BaseJcon, filtro?: FiltroJcon): string[][];
