export type Cifras = { roster: number | null; entraron_a_su_clase: number | null; fueron_a_otra: number | null; no_aparecieron: number | null;
  no_medibles: number | null; visitas_recibidas: number | null };
export type NivelCorte = "semana" | "dia" | "ciudad" | "ciudad_dia";
export type FilaNivel = Cifras & { semana: string; nivel: NivelCorte; ciudad: string | null; dia: string | null; materia: string | null; suprimido: boolean };
export type FilaClaseCorte = Cifras & { semana: string; ciudad: string; slot_id: string; materia: string | null; dia: string; fecha: string;
  hora_inicio: number | null; hora_fin: number | null; cuenta_zoom: string | null; tipo: string | null; sala: string | null; estado_captura: string | null;
  suprimido: boolean; mediana_pct_tiempo: number | null };
export type DatosEstadisticas = { disponible: true; semana: string; materia: string | null; niveles: FilaNivel[]; clases: FilaClaseCorte[]; serie: FilaNivel[] };
export type EstadisticasRespuesta = DatosEstadisticas | { disponible: false; motivo: string };
export type FiltrosEstadisticas = { ciudad: string; dia: string; cuenta: string; tipo: string };
export type CeldaCorte = { estado: "vacia" | "suprimida" | "ok"; cifras?: Cifras; pct?: number | null; semaforo?: string };
export const TEXTO_SUPRIMIDO: string;
export const SIN_DATO: string;
export const ORDEN_DIAS: readonly string[];
export const SEMAFORO: Readonly<{ verde: number; amarillo: number }>;
export const CIFRAS: readonly (keyof Cifras)[];
export const FILTROS_VACIOS: Readonly<FiltrosEstadisticas>;
export const LEYENDA_ESTADISTICAS: string;
export const NOTA_SUPRESION: string;
export const HEADER_CSV_ESTADISTICAS: readonly string[];
export function normalizarDia(d: unknown): string;
export function filtrosActivos(f: FiltrosEstadisticas): boolean;
export function hayFiltroDeClase(f: FiltrosEstadisticas): boolean;
export function opcionesFiltros(datos: Pick<DatosEstadisticas, "niveles" | "clases"> | null | undefined): { ciudades: string[]; dias: string[]; cuentas: string[]; tipos: string[] };
export function filtrarClases(clases: FilaClaseCorte[], f: FiltrosEstadisticas): FilaClaseCorte[];
export function nivelParaFiltros(f: FiltrosEstadisticas): NivelCorte;
export function pctEntro(c: Partial<Cifras> | null | undefined): number | null;
export function semaforo(pct: number | null): "verde" | "amarillo" | "rojo" | "sin_dato";
export function cifrasDelCorte(datos: DatosEstadisticas | null | undefined, f: FiltrosEstadisticas): { fuente: "nivel" | "clases" | "ninguna"; nivel: string;
  suprimido: boolean; cifras: Cifras | null; motivo: string | null; clases?: number };
export function tablaCiudadDia(datos: DatosEstadisticas | null | undefined, f: FiltrosEstadisticas): { dias: string[];
  filas: { ciudad: string; total: CeldaCorte; celdas: CeldaCorte[] }[]; totalesDia: CeldaCorte[]; totalSemana: CeldaCorte | null };
export function etiquetaClase(c: Partial<FilaClaseCorte>): string;
export type FilaTablaClase = { clave: string; slot_id: string; ciudad: string; clase: string; materia: string; cuenta_zoom: string; tipo: string; fecha: string;
  suprimido: boolean; cifras: Cifras | null; pct: number | null; mediana: number | null; confianza: string; estado_captura: string | null };
export function tablaClases(datos: DatosEstadisticas | null | undefined, f: FiltrosEstadisticas): FilaTablaClase[];
export function barrasCiudades(datos: DatosEstadisticas | null | undefined, f: FiltrosEstadisticas): { ciudad: string; estado: "vacia" | "suprimida" | "ok";
  pct: number | null; roster: number | null; semaforo?: string }[];
export function tendenciaPorCiudad(serie: FilaNivel[] | null | undefined, f: FiltrosEstadisticas): { semanas: string[];
  series: { ciudad: string; puntos: { semana: string; estado: "vacia" | "suprimida" | "ok"; pct: number | null; roster?: number | null }[] }[] };
export function construirCsvEstadisticas(datos: DatosEstadisticas, f: FiltrosEstadisticas): { contenido: string; archivo: string };
export function explicarVacio(datos: DatosEstadisticas | null | undefined, f: FiltrosEstadisticas): string;
